{
  "version": 2,
  "builds": [
    {
      "src": "back-end/api-vercel.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/back-end/api-vercel.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
